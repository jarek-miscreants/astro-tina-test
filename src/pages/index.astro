---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import SectionMain from "../components/SectionMain.astro";
import CardFeatured from "../components/CardFeatured.astro";
import { Icon } from "astro-icon/components";
import featureOne from "../images/feature-1.webp";
import Tabs from "../components/Tabs.astro";
import Accordion from "../components/Accordion.astro";
import { getCollection, getEntry, render } from "astro:content";
import LogoMarquee from "../components/LogoMarquee.astro";
import Footer from "../components/Footer.astro";
import SliderBasic from "../components/SliderBasic.astro";
import SliderBasicMap from "../components/SliderBasicMap.astro";
import FeatureScrollSpy from "../components/FeatureScrollSpy.astro";
import Modal from "../components/Modal.astro";
import clients from "../data/clients.json";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";

// Tina-editable page content. Each block is dispatched to its renderer in
// BlockRenderer; the order/contents of `home.json` controls what shows up.
// Sections not listed here (Tabs, SliderBasic, FeatureScrollSpy, Modal) stay
// hardcoded below — their custom slot children don't model cleanly as data.
const home = await getEntry("pages", "home");
const blocks = home?.data.blocks ?? [];

const faqs = (await getCollection("faq"))
  .filter((faq) => faq.data.page === "homepage")
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={home?.data.title ?? "Astro Playground"}>
  <main id="main">

    {/* Editable blocks (Tina) — Hero, Features, IconStats, AccordionMorph, FlowSteps */}
    {blocks.map((block) => <BlockRenderer block={block} />)}

    {/* --- Demo sections kept hardcoded; not editable in Tina --- */}

    <SectionMain id="clients" padding="none" contentPadding="none" borderTop>
      <div data-accent="tl"></div><div data-accent="tr"></div>
      <div data-accent="bl"></div><div data-accent="br"></div>
      <LogoMarquee>
        {clients.map((client) => (
          <img src={client.logo} alt={client.name} class="w-24 h-16" />
        ))}
      </LogoMarquee>
    </SectionMain>

    <SectionMain id="tabs" padding="sm">
      <div data-accent="tl"></div>
      <div data-accent="tr"></div>
      <div data-accent="bl"></div>
      <div data-accent="br"></div>
      <div class="flex flex-col gap-4 mb-6">
        <h2 class="h3">Tabs Component</h2>
        <p class="mt-2 text-fg-muted">Accessible tabs with accordion conversion on mobile.</p>
      </div>

      <Tabs id="demo" convertAccordion slideTabs>
        <div data-tab="button-list" class="flex w-full gap-1 border-b border-stroke [&>*]:flex-1 [&>*]:justify-center">
          <button data-tab="button" class="px-4 py-3 text-sm text-fg-muted border-b-2 border-transparent cursor-pointer transition-colors hover:text-fg [&.is-active]:text-fg [&.is-active]:border-fg">
            <span class="flex items-center gap-2">
              <Icon name="lucide:layers" class="w-4 h-4" aria-hidden="true" />
              Overview
            </span>
          </button>
          <button data-tab="button" class="px-4 py-3 text-sm text-fg-muted border-b-2 border-transparent cursor-pointer transition-colors hover:text-fg [&.is-active]:text-fg [&.is-active]:border-fg">
            <span class="flex items-center gap-2">
              <Icon name="lucide:zap" class="w-4 h-4" aria-hidden="true" />
              Features
            </span>
          </button>
          <button data-tab="button" class="px-4 py-3 text-sm text-fg-muted border-b-2 border-transparent cursor-pointer transition-colors hover:text-fg [&.is-active]:text-fg [&.is-active]:border-fg">
            <span class="flex items-center gap-2">
              <Icon name="lucide:code" class="w-4 h-4" aria-hidden="true" />
              Code
            </span>
          </button>
        </div>
        <div data-tab="panel-list" class="py-8">
          <div data-tab="panel">
            <div class="py-4 md:py-2">
              <h3 class="h4 mb-4">Built for speed</h3>
              <p class="text-fg-muted max-w-2xl">Astro delivers lightning-fast websites by shipping zero JavaScript by default. Only hydrate the components that need interactivity — everything else is pure HTML.</p>
            </div>
          </div>
          <div data-tab="panel">
            <div class="py-4 md:py-2">
              <h3 class="h4 mb-4">Island architecture</h3>
              <p class="text-fg-muted max-w-2xl">Each interactive component is an isolated island. They load independently, so a slow component never blocks the rest of your page from rendering.</p>
            </div>
          </div>
          <div data-tab="panel">
            <div class="py-4 md:py-2">
              <h3 class="h4 mb-4">Framework agnostic</h3>
              <p class="text-fg-muted max-w-2xl">Use React, Vue, Svelte, or Solid — all in the same project. Astro lets you pick the best tool for each component without locking you into a single framework.</p>
            </div>
          </div>
        </div>
      </Tabs>
    </SectionMain>

    <SectionMain id="accordion" padding="sm" borderTop>
      <div class="flex flex-col gap-4 mb-6">
        <h2 class="h3">Accordion Component</h2>
        <p class="mt-2 text-fg-muted">FAQ-style accordion with CSS-only animations.</p>
      </div>

      <Accordion openByDefault={1} class="flex flex-col">
        {faqs.map(async (faq) => {
          const { Content } = await render(faq);
          return (
            <div data-accordion="item" class="bg-canvas border-b border-stroke group">
              <button data-accordion="button" class="flex w-full items-center justify-between py-5 cursor-pointer text-left group-hover:text-fg">
                <span class="h5">{faq.data.question}</span>
                <Icon data-accordion="icon" name="lucide:chevron-down" class="w-5 h-5 text-fg-muted shrink-0" aria-hidden="true" />
              </button>
              <div data-accordion="content">
                <div class="pb-5 text-fg-muted">
                  <Content />
                </div>
              </div>
            </div>
          );
        })}
      </Accordion>
    </SectionMain>

    <SectionMain id="slider-basic" padding="sm" borderTop>
      <div class="flex flex-col gap-4 mb-6">
        <h2 class="h3">Slider — manual children</h2>
        <p class="mt-2 text-fg-muted">CSS scroll-snap carousel. Drop any components in as direct children.</p>
      </div>

      <SliderBasic mobile={1} mobileLandscape={2} tablet={2} desktop={3} gap="md" ariaLabel="Featured cards">
        <CardFeatured title="Slide one" titleClass="h4" description="Native scroll-snap means swipe and trackpad inertia work for free." class="bg-panel">
          <span slot="eyebrow">Performance</span>
          <Icon slot="icon" name="lucide:zap" class="w-6 h-6 text-fg-muted" aria-hidden="true" />
        </CardFeatured>
        <CardFeatured title="Slide two" titleClass="h4" description="Prev/next, keyboard arrows, and pagination dots are all wired up." class="bg-panel">
          <span slot="eyebrow">Accessibility</span>
          <Icon slot="icon" name="lucide:keyboard" class="w-6 h-6 text-fg-muted" aria-hidden="true" />
        </CardFeatured>
        <CardFeatured title="Slide three" titleClass="h4" description="Zero JS dependencies. Just ~1.5kb of inline script per slider." class="bg-panel">
          <span slot="eyebrow">Lightweight</span>
          <Icon slot="icon" name="lucide:feather" class="w-6 h-6 text-fg-muted" aria-hidden="true" />
        </CardFeatured>
        <CardFeatured title="Slide four" titleClass="h4" description="Each direct child becomes a slide. No wrapper element required." class="bg-panel">
          <span slot="eyebrow">DX</span>
          <Icon slot="icon" name="lucide:wrench" class="w-6 h-6 text-fg-muted" aria-hidden="true" />
        </CardFeatured>
      </SliderBasic>
    </SectionMain>

    <SectionMain id="slider-mapped" padding="sm" borderTop>
      <div class="flex flex-col gap-4 mb-6">
        <h2 class="h3">Slider — mapped from data</h2>
        <p class="mt-2 text-fg-muted">Same component, fed from an array (could be a content collection).</p>
      </div>

      <SliderBasicMap
        mobile={1}
        mobileLandscape={2}
        tablet={2}
        desktop={3}
        gap="md"
        ariaLabel="Mapped slides"
        titleClass="h4"
        titleTag="h4"
        items={[
          { eyebrow: "Guide", title: "Getting started",  description: "Spin up a project in under five minutes." },
          { eyebrow: "Reference", title: "Component API", description: "Props, slots, and data attributes for every component." },
          { eyebrow: "Tutorial", title: "Build a landing page", description: "Walk through composing sections from the starter kit." },
          { eyebrow: "Recipes", title: "Theming patterns", description: "Light/dark variants using Tailwind v4 tokens." },
        ]}
      />
    </SectionMain>

    <SectionMain id="scrollspy" padding="md" borderTop>
      <div class="flex flex-col gap-4 mb-12">
        <h2 class="h3">Feature scroll-spy</h2>
        <p class="mt-2 text-fg-muted">Sticky TOC on the left, scrolling content on the right. Active item updates as you scroll.</p>
      </div>

      <FeatureScrollSpy
        tocLabel="Capabilities"
        ariaLabel="Feature sections"
        items={[
          { id: "spy-workflows", label: "Real-time workflows", eyebrow: "01" },
          { id: "spy-lifecycle", label: "Data lifecycle",     eyebrow: "02" },
          { id: "spy-schema",    label: "Schema-driven",      eyebrow: "03" },
          { id: "spy-perf",      label: "Performance",        eyebrow: "04" },
        ]}
      >
        <article id="spy-workflows">
          <span class="text-body-sm text-fg-muted">Real-time workflows</span>
          <h3 class="h3 mt-2">Collaborate without losing context.</h3>
          <p class="mt-4 text-fg-muted max-w-prose">
            Every change syncs instantly across teammates. Cursors, selections, and comments stay in lockstep so reviews happen in the document, not in a separate thread.
          </p>
          <img src={featureOne.src} alt="Workflow screenshot" class="mt-6 w-full mask-b-from-30% mask-b-to-95%" />
        </article>

        <article id="spy-lifecycle">
          <span class="text-body-sm text-fg-muted">Data lifecycle</span>
          <h3 class="h3 mt-2">From ingest to archive in one place.</h3>
          <p class="mt-4 text-fg-muted max-w-prose">
            Track every dataset through versioning, review, and approval. Audit trails are immutable; reverting is one click; nothing falls through the cracks.
          </p>
          <img src={featureOne.src} alt="Lifecycle screenshot" class="mt-6 w-full mask-b-from-30% mask-b-to-95%" />
        </article>

        <article id="spy-schema">
          <span class="text-body-sm text-fg-muted">Schema-driven</span>
          <h3 class="h3 mt-2">Structure your data your way.</h3>
          <p class="mt-4 text-fg-muted max-w-prose">
            Define schemas with the same primitives as your codebase. Strong typing flows through forms, validation, and the public API — no runtime surprises.
          </p>
          <img src={featureOne.src} alt="Schema screenshot" class="mt-6 w-full mask-b-from-30% mask-b-to-95%" />
        </article>

        <article id="spy-perf">
          <span class="text-body-sm text-fg-muted">Performance</span>
          <h3 class="h3 mt-2">Built for scale, by default.</h3>
          <p class="mt-4 text-fg-muted max-w-prose">
            Hundreds of millions of daily fetches, sub-50ms p95s in every region. Performance isn't an upgrade tier — it's the baseline.
          </p>
          <img src={featureOne.src} alt="Performance screenshot" class="mt-6 w-full mask-b-from-30% mask-b-to-95%" />
        </article>
      </FeatureScrollSpy>
    </SectionMain>

    <SectionMain id="modal" padding="sm" borderTop>
      <div class="flex flex-col gap-4 mb-6">
        <h2 class="h3">Modal</h2>
        <p class="mt-2 text-fg-muted">Native &lt;dialog&gt; with Pattern 1 wiring — buttons declare their target by id, multiple triggers can open the same modal.</p>
      </div>

      <ButtonGroup>
        <Button label="Open signup" data-modal-open="demo-signup" />
        <Button label="Open confirm" variant="secondary" data-modal-open="demo-confirm" />
        <Button label="Same modal again" variant="secondary" data-modal-open="demo-signup" />
      </ButtonGroup>
    </SectionMain>

    <Modal id="demo-signup" size="md" ariaLabel="Sign up">
      <h2 slot="title">Create your account</h2>
      <p slot="description">Spin up a project in under five minutes.</p>

      <form class="flex flex-col gap-3" onsubmit="event.preventDefault(); this.closest('dialog').close();">
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-fg-muted">Email</span>
          <input
            type="email"
            required
            data-modal-autofocus
            class="border border-stroke bg-canvas px-3 py-2 text-sm text-fg outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
          />
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="text-fg-muted">Password</span>
          <input
            type="password"
            required
            minlength={8}
            class="border border-stroke bg-canvas px-3 py-2 text-sm text-fg outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
          />
        </label>
      </form>

      <Fragment slot="footer">
        <Button label="Cancel" variant="secondary" data-modal-close />
        <Button label="Create account" />
      </Fragment>
    </Modal>

    <Modal id="demo-confirm" size="sm" ariaLabel="Confirm action">
      <h2 slot="title">Delete project?</h2>
      <p slot="description">This action can't be undone. All associated data will be permanently removed.</p>

      <Fragment slot="footer">
        <Button label="Cancel" variant="secondary" data-modal-close />
        <Button label="Delete" data-modal-close />
      </Fragment>
    </Modal>

  </main>
  <Footer borderTop={true} />
</Layout>
