---
import SectionMain from "../SectionMain.astro";
import CardIcon from "../CardIcon.astro";
import { Icon } from "astro-icon/components";

interface StatItem {
  icon?: string;
  header?: string;
  content?: string;
}

interface Props {
  items?: StatItem[];
}

const { items = [] } = Astro.props;
---

<SectionMain id="icons" padding="none" contentPadding="none">
  <div class="container-large">
    <div class="section-pattern-horizontal w-full py-10"></div>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-0 border-y border-stroke divide-y lg:divide-y-0">
      {items.map((item) => (
        <CardIcon header={item.header} class="bg-canvas">
          {item.icon && (
            <Icon
              slot="icon"
              name={item.icon}
              class="w-6 h-6 text-fg-muted mb-4"
              aria-hidden="true"
            />
          )}
          <p slot="content">{item.content}</p>
        </CardIcon>
      ))}
    </div>
  </div>
</SectionMain>
