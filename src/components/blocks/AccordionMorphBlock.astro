---
import SectionMain from "../SectionMain.astro";
import AccordionMorph from "../AccordionMorph.astro";
import Grid from "../Grid.astro";

interface MorphItem {
  icon?: string;
  title?: string;
  description?: string;
}

interface Props {
  ariaLabel?: string;
  openIndex?: number;
  items?: MorphItem[];
}

const { ariaLabel = "Frequently asked questions", openIndex = 0, items = [] } =
  Astro.props;
---

<SectionMain id="accordion-morph" padding="sm" borderTop>
  <Grid mobile={1} mobileLandscape={2} tablet={2} desktop={2} gap="sm">
    <div class="flex flex-col gap-4 mb-6">
      <h2 class="h3">Accordion — morphing</h2>
      <p class="mt-2 text-fg-muted">
        Native &lt;details&gt; with mutually-exclusive open via shared `name`.
        Bouncy height interpolation, fade/blur content, and morphing
        radius/margin between rows.
      </p>
    </div>
    <div class="max-w-full">
      <AccordionMorph
        ariaLabel={ariaLabel}
        openIndex={openIndex}
        items={items}
      />
    </div>
  </Grid>
</SectionMain>
